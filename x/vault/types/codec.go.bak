package types

import (
	sdk "github.com/cosmos/cosmos-sdk/types"
	cdctypes "github.com/cosmos/cosmos-sdk/codec/types"
	"github.com/cosmos/cosmos-sdk/types/msgservice"
)

// RegisterInterfaces registers all vault interfaces and Msg services.
func RegisterInterfaces(reg cdctypes.InterfaceRegistry) {
	// Register all Msg implementations
	reg.RegisterImplementations(
		(*sdk.Msg)(nil),
		&MsgDeposit{},
		&MsgUpdateParams{},
	)

	// Register the auto-generated Msg service descriptor
	msgservice.RegisterMsgServiceDesc(reg, &_Msg_serviceDesc)
}
