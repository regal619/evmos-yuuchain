package module

import (
    appconfig "cosmossdk.io/depinject/appconfig"
    vaultmodulev1 "yuuchain/x/vault/module/v1"
)

// Register this module's depinject provider so the type URL
// /yuuchain.vault.module.v1.Module is wired at runtime.
func init() {
    appconfig.Register(&vaultmodulev1.Module{}, appconfig.Provide(ProvideModule))
}
